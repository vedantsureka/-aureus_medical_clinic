# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# PRIVATE: Set in Vercel project environment variables. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
# Optional but recommended for spam prevention; configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Your actual production hostname; used in SEO metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
